# =============================================
# WhatsApp AI Assistant & Campaign Manager
# Copy this to backend/.env (same directory as backend/package.json)
# and fill in your values
# =============================================

# ─── AI Provider (OpenAI-compatible API) ──────────────────────
AI_API_KEY=replace_with_nvidia_api_key
AI_BASE_URL=https://integrate.api.nvidia.com/v1
AI_MODEL=meta/llama-3.1-8b-instruct

# ─── Ask AI (optional feature-scoped override) ────────────────
# DEDICATED key/model for the Ask AI feature only. When set, Ask AI uses
# these instead of the generic AI_* pair (tenant-stored keys still win).
# Falls back to AI_API_KEY / AI_MODEL when unset.
# ASK_AI_API_KEY=
# ASK_AI_API_MODEL=

# ─── Document Intelligence (BOQ extraction) ──────────────────
# Feature-scoped override: used ONLY by the BOQ extraction route.
# Falls back to AI_API_KEY / AI_BASE_URL / AI_MODEL when unset.
# Also used by proforma "upload invoice" field extraction.
# DOCUMENT_INTELLIGENCE_NVIDIA_BASE_URL= (optional; defaults to AI_BASE_URL)

# Any OpenAI-compatible host works. OpenRouter example (reasoning is
# switched off with OpenRouter's own `reasoning` field automatically):
#   DOCUMENT_INTELLIGENCE_NVIDIA_BASE_URL=https://openrouter.ai/api/v1
#   DOCUMENT_INTELLIGENCE_NVIDIA_API_KEY=<OpenRouter key>
#   DOCUMENT_INTELLIGENCE_NVIDIA_MODEL=nvidia/nemotron-3-ultra-550b-a55b
# Proforma extraction streams the answer inside its 100s budget. A request
# that sends nothing for this long is treated as stuck and retried once.
# PROFORMA_EXTRACT_IDLE_MS=30000

# ONE wall-time budget for the extraction phase (text extraction, every
# per-chunk AI call AND its retries). Keep it at least ~15s BELOW the
# frontend's '/boq/process' budget (110s in frontend/src/api.js) — the two
# values are documented as one budget and must be changed together.
# BOQ_TOTAL_BUDGET_MS=90000
# Per-call floor (smallest useful single attempt). Also derives the default
# chunk cap: BOQ_MAX_CHUNKS = BOQ_TOTAL_BUDGET_MS ÷ BOQ_AI_MIN_CALL_MS (= 4
# at the defaults) unless BOQ_MAX_CHUNKS is set explicitly.
# BOQ_AI_MIN_CALL_MS=20000
# Per-call ceiling — a single attempt can never hog the budget, so a failed
# attempt always leaves room for the one transient retry (timeout/socket
# break, HTTP 429, HTTP 5xx).
# BOQ_AI_MAX_CALL_MS=45000
# Force the thinking-suppression capability on/off instead of auto-detecting
# model families: deepseek/qwen/glm/nemotron get chat_template_kwargs.thinking;
# gpt-oss models get top-level reasoning_effort ('none' → 'low', its minimum).
# Set false for gateways whose models reject these parameters.
# AI_SUPPORTS_THINKING_KWARGS=

# ─── Image Extractor ──────────────────────────────────────────
NVIDIA_API_KEY=replace_with_nvidia_api_key
NVIDIA_MODEL=nvidia/nemotron-ocr-v1
NVIDIA_STRUCTURED_MODEL=meta/llama-3.2-11b-vision-instruct

# ─── Sales Call Analyzer ──────────────────────────────────────
SALES_CALL_NVIDIA_API_KEY=replace_with_nvidia_api_key
SALES_CALL_NVIDIA_MODEL=nvidia/llama-3.1-nemotron-70b-instruct

# ─── WhatsApp ─────────────────────────────────────────────────
WHATSAPP_PROVIDER=web
DEFAULT_COUNTRY_CODE=91
WABA_PHONE_NUMBER_ID=
WABA_ACCESS_TOKEN=
WABA_WEBHOOK_VERIFY_TOKEN=
WABA_API_VERSION=v23.0

# Meta App Secret — REQUIRED for webhook security. The backend verifies
# every webhook POST's X-Hub-Signature-256 HMAC against this secret and
# REJECTS payloads it cannot verify (fail closed). Copy it from
# Meta App Dashboard → App Settings → Basic → App Secret.
# Per-user alternative: store {"appSecret": "..."} as JSON in the
# app_settings row with key APP_SECRET for that user.
WABA_APP_SECRET=

# ─── Email Campaigns (Resend) ────────────────────────────────
# Server-level fallbacks only. Each user normally configures their own
# Resend credentials in Settings → Email (Resend); stored per-user
# settings take precedence over these env values.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
RESEND_FROM_NAME=

# ─── Bulk Email over SMTP (FREE) ─────────────────────────────
# Run supabase-email-campaigns-migration.sql first. Users normally set these
# in Settings → Email. Gmail: turn on 2-Step Verification, create an App
# Password at https://myaccount.google.com/apppasswords and use it as
# SMTP_PASS (free Gmail ≈ 500 emails/day, Google Workspace ≈ 2000/day).
# Host/port are filled in automatically for Gmail, Outlook, Yahoo and Zoho.
# EMAIL_PROVIDER: smtp | resend (blank = smtp when set up)
EMAIL_PROVIDER=
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM_NAME=
# Public backend URL used in unsubscribe links (Render sets
# RENDER_EXTERNAL_URL automatically; set this if you host elsewhere).
BACKEND_PUBLIC_URL=

# ─── Server ───────────────────────────────────────────────────
PORT=3000

# IANA timezone for business hours (rate limiting) and schedule duration
# estimates. Defaults to 'Asia/Kolkata' when unset. Applies wherever a
# "local" wall clock matters: the send loop's outside-hours pause and
# wait-time calculations. Examples: 'Asia/Kolkata', 'Europe/Berlin',
# 'UTC'.
# APP_TIMEZONE=Asia/Kolkata

# ─── Encryption at rest (REQUIRED) ───────────────────────────
# AES-256-GCM key for encrypting secrets (AI/Resend API keys, WhatsApp
# tokens, Baileys auth state) before they are stored in Supabase.
# The server REFUSES to start without it. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Do NOT change this value once secrets are stored — stored ciphertexts
# become unreadable.
ENCRYPTION_KEY=replace_with_64_hex_chars_from_command_above

# Set to "true" ONLY during local development when you want to bypass
# authentication entirely. NEVER set this to true in production.
AUTH_DISABLED=false

# ─── Business Info ────────────────────────────────────────────
# Defaults for new tenants. Every user can override these per-account
# in Settings → Business information (stored in their app_settings rows).
ADMIN_NUMBERS=919000000000
BUSINESS_NAME=Sudarshan Pipes
BUSINESS_TAGLINE=Polymer & Plastic Pipe Manufacturing — PVC and PE/HDPE Solutions for Water, Irrigation, Drainage, Gas & Infrastructure

# ─── Supabase — Backend (server-side only) ────────────────────
# Used by the backend middleware to validate Supabase JWTs.
# NEVER prefix with VITE_ — this key must NEVER reach the browser.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=sb_secret_your_service_role_key_here

# ─── Supabase — Frontend (Vite / browser-safe) ───────────────
# These are safe to expose to the browser — they are NOT secret.
# Do not add any secret/service-role key here.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_anon_key_here

# Additional browser origins allowed by the backend CORS policy (comma-separated).
# Existing production, preview, and localhost defaults remain enabled.
ALLOWED_ORIGINS=

# ─── STORAGE MONITORING & "DOWNLOAD NOW + CLEAN UP" ──────────
# Run supabase-storage-monitor-migration.sql first. Storage administrators
# are the KYC staff list (private.kyc_staff). No extra keys are needed.
# Optional: external scheduler (Render Cron Job / cron-job.org) when the server
# can sleep. POST /api/storage/cron with header X-Cron-Secret: <value> (16+ chars).
STORAGE_CRON_SECRET=
# Optional: link used in alert emails (defaults to the production frontend).
APP_PUBLIC_URL=
# Optional: minutes between checks (default 10); 'true' disables the timer.
STORAGE_TICK_MINUTES=
STORAGE_MONITOR_DISABLED=

# ─── TEAM & ACCESS (super admins give areas by email) ────────
# Comma-separated emails of the first super admins. They always have every
# area and manage "Team & access"; they cannot be demoted from the screen.
# The first one's account is the company workspace everyone works on
# (changeable on the screen). Team & access is ON only when this is set AND
# supabase-team-access-migration.sql has run; from then on, accounts get NO
# access until a super admin gives it. Leave empty to keep today's behaviour.
# SUPER_ADMIN_EMAILS=owner@example.com
SUPER_ADMIN_EMAILS=

# ─── STAFF & MEMBER LOGIN (/staff-login, staff dashboard) ────
# REQUIRED for staff login. Signs the 12-hour staff session tokens.
# At least 32 characters;
# without it every POST /api/staff-portal/login returns 503 "Staff login is
# not configured on the server". Changing it signs every staff member out.
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
STAFF_SESSION_SECRET=
# Also needed (already set for the rest of the app): SUPABASE_URL,
# SUPABASE_SECRET_KEY.
# Check after deploy: GET /api/staff-portal/health → { configured, missing }.
# Optional limits: STAFF_LOGIN_LIMIT_PER_15MIN (default 20 per network).

# ─── REMOVED VARIABLES ────────────────────────────────────────
# The following variables from the old custom auth are NO LONGER USED:
#   JWT_SECRET          — replaced by Supabase Auth
#   ADMIN_USERNAME      — replaced by Supabase Auth
#   ADMIN_PASSWORD      — replaced by Supabase Auth

# ─── Billing — Razorpay monthly subscription ─────────────────
# Run supabase-billing-migration.sql first. Super admins tick, in
# Setup → Subscriptions, which accounts must pay and how much per month.
# Keys: Razorpay Dashboard → Account & Settings → API Keys (use rzp_test_…
# keys to try it without real money). These are YOUR platform keys —
# server env only, never per-user settings.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Optional backup: Dashboard → Webhooks → URL
# https://<backend>/api/billing/webhook, events payment.captured + order.paid
RAZORPAY_WEBHOOK_SECRET=
