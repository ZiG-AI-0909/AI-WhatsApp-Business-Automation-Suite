# =============================================
# WhatsApp AI Assistant & Campaign Manager
# Copy this to backend/.env (same directory as backend/package.json)
# and fill in your values
# =============================================

# ─── AI Provider (OpenAI-compatible API) ──────────────────────
AI_API_KEY=replace_with_nvidia_api_key
AI_BASE_URL=https://integrate.api.nvidia.com/v1
AI_MODEL=meta/llama-3.1-8b-instruct

# ─── Ask AI (optional feature-scoped override) ────────────────
# DEDICATED key/model for the Ask AI feature only. When set, Ask AI uses
# these instead of the generic AI_* pair (tenant-stored keys still win).
# Falls back to AI_API_KEY / AI_MODEL when unset.
# ASK_AI_API_KEY=
# ASK_AI_API_MODEL=

# ─── Document Intelligence (BOQ extraction) ──────────────────
# Feature-scoped override: used ONLY by the BOQ extraction route.
# Falls back to AI_API_KEY / AI_BASE_URL / AI_MODEL when unset.
# DOCUMENT_INTELLIGENCE_NVIDIA_BASE_URL= (optional; defaults to AI_BASE_URL)
DOCUMENT_INTELLIGENCE_NVIDIA_API_KEY=replace_with_nvidia_api_key
DOCUMENT_INTELLIGENCE_NVIDIA_MODEL=deepseek-ai/deepseek-v4-flash-0731

# ONE wall-time budget for the extraction phase (text extraction, every
# per-chunk AI call AND its retries). Keep it at least ~15s BELOW the
# frontend's '/boq/process' budget (110s in frontend/src/api.js) — the two
# values are documented as one budget and must be changed together.
# BOQ_TOTAL_BUDGET_MS=90000
# Per-call floor (smallest useful single attempt). Also derives the default
# chunk cap: BOQ_MAX_CHUNKS = BOQ_TOTAL_BUDGET_MS ÷ BOQ_AI_MIN_CALL_MS (= 4
# at the defaults) unless BOQ_MAX_CHUNKS is set explicitly.
# BOQ_AI_MIN_CALL_MS=20000
# Per-call ceiling — a single attempt can never hog the budget, so a failed
# attempt always leaves room for the one transient retry (timeout/socket
# break, HTTP 429, HTTP 5xx).
# BOQ_AI_MAX_CALL_MS=45000
# Force the thinking-suppression capability on/off instead of auto-detecting
# model families: deepseek/qwen/glm/nemotron get chat_template_kwargs.thinking;
# gpt-oss models get top-level reasoning_effort ('none' → 'low', its minimum).
# Set false for gateways whose models reject these parameters.
# AI_SUPPORTS_THINKING_KWARGS=

# ─── Image Extractor ──────────────────────────────────────────
NVIDIA_API_KEY=replace_with_nvidia_api_key
NVIDIA_MODEL=nvidia/nemotron-ocr-v1
NVIDIA_STRUCTURED_MODEL=meta/llama-3.2-11b-vision-instruct

# ─── Sales Call Analyzer ──────────────────────────────────────
SALES_CALL_NVIDIA_API_KEY=replace_with_nvidia_api_key
SALES_CALL_NVIDIA_MODEL=nvidia/llama-3.1-nemotron-70b-instruct

# ─── WhatsApp ─────────────────────────────────────────────────
WHATSAPP_PROVIDER=web
DEFAULT_COUNTRY_CODE=91
WABA_PHONE_NUMBER_ID=
WABA_ACCESS_TOKEN=
WABA_WEBHOOK_VERIFY_TOKEN=
WABA_API_VERSION=v23.0

# Meta App Secret — REQUIRED for webhook security. The backend verifies
# every webhook POST's X-Hub-Signature-256 HMAC against this secret and
# REJECTS payloads it cannot verify (fail closed). Copy it from
# Meta App Dashboard → App Settings → Basic → App Secret.
# Per-user alternative: store {"appSecret": "..."} as JSON in the
# app_settings row with key APP_SECRET for that user.
WABA_APP_SECRET=

# ─── Email Campaigns (Resend) ────────────────────────────────
# Server-level fallbacks only. Each user normally configures their own
# Resend credentials in Settings → Email (Resend); stored per-user
# settings take precedence over these env values.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
RESEND_FROM_NAME=

# ─── Server ───────────────────────────────────────────────────
PORT=3000

# Set to "true" ONLY during local development when you want to bypass
# authentication entirely. NEVER set this to true in production.
AUTH_DISABLED=false

# ─── Business Info ────────────────────────────────────────────
# Defaults for new tenants. Every user can override these per-account
# in Settings → Business information (stored in their app_settings rows).
ADMIN_NUMBERS=919000000000
BUSINESS_NAME=Sudarshan Pipes
BUSINESS_TAGLINE=Polymer & Plastic Pipe Manufacturing — PVC and PE/HDPE Solutions for Water, Irrigation, Drainage, Gas & Infrastructure

# ─── Supabase — Backend (server-side only) ────────────────────
# Used by the backend middleware to validate Supabase JWTs.
# NEVER prefix with VITE_ — this key must NEVER reach the browser.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=sb_secret_your_service_role_key_here

# ─── Supabase — Frontend (Vite / browser-safe) ───────────────
# These are safe to expose to the browser — they are NOT secret.
# Do not add any secret/service-role key here.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_anon_key_here

# ─── REMOVED VARIABLES ────────────────────────────────────────
# The following variables from the old custom auth are NO LONGER USED:
#   JWT_SECRET          — replaced by Supabase Auth
#   ADMIN_USERNAME      — replaced by Supabase Auth
#   ADMIN_PASSWORD      — replaced by Supabase Auth
